/* GeoFlow QGIS 플러그인 - Dynamic Form 공통 스타일
   중앙 정의로 생성된 모든 입력 위젯의 AdminKit 계열 표현을 통일한다. */

/* ==========================================================
   속성폼 기본 화면과 그룹
   ========================================================== */
#GeoFlowDynamicForm {
    background: #f8f9fa;
    color: #495057;
    font-size: 12px;
}

#GeoFlowDynamicForm QGroupBox {
    background: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 5px;
    margin-top: 16px;
    padding: 12px 10px 10px 10px;
    font-weight: 500;
    color: #495057;
}

#GeoFlowDynamicForm QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ==========================================================
   필드 Label · 필수 표시 · 검증 메시지
   ========================================================== */
#GeoFlowDynamicForm QLabel[geoflowRole="fieldLabel"] {
    color: #6c757d;
    font-size: 10px;
    font-weight: 500;
    background: transparent;
}

#GeoFlowDynamicForm QLabel[geoflowRole="requiredMarker"] {
    color: #dc3545;
    font-size: 11px;
    background: transparent;
}

#GeoFlowDynamicForm QLabel[geoflowRole="fieldError"] {
    color: #dc3545;
    font-size: 10px;
    font-weight: normal;
    background: transparent;
}

/* ==========================================================
   기본 입력 위젯과 Hover · Focus 상태
   ========================================================== */
#GeoFlowDynamicForm QLineEdit[geoflowInput="true"],
#GeoFlowDynamicForm QTextEdit[geoflowInput="true"],
#GeoFlowDynamicForm QComboBox[geoflowInput="true"],
#GeoFlowDynamicForm QSpinBox[geoflowInput="true"],
#GeoFlowDynamicForm QDoubleSpinBox[geoflowInput="true"],
#GeoFlowDynamicForm QDateEdit[geoflowInput="true"],
#GeoFlowDynamicForm QDateTimeEdit[geoflowInput="true"] {
    background: #ffffff;
    color: #1b1d1f;
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 0 9px;
    selection-background-color: #3b7ddd;
    selection-color: #ffffff;
    font-size: 12px;
}

#GeoFlowDynamicForm QTextEdit[geoflowInput="true"] {
    padding: 7px 9px;
}

#GeoFlowDynamicForm QLineEdit[geoflowInput="true"]:hover,
#GeoFlowDynamicForm QTextEdit[geoflowInput="true"]:hover,
#GeoFlowDynamicForm QComboBox[geoflowInput="true"]:hover,
#GeoFlowDynamicForm QSpinBox[geoflowInput="true"]:hover,
#GeoFlowDynamicForm QDoubleSpinBox[geoflowInput="true"]:hover,
#GeoFlowDynamicForm QDateEdit[geoflowInput="true"]:hover,
#GeoFlowDynamicForm QDateTimeEdit[geoflowInput="true"]:hover {
    border-color: #adb5bd;
}

#GeoFlowDynamicForm QLineEdit[geoflowInput="true"]:focus,
#GeoFlowDynamicForm QTextEdit[geoflowInput="true"]:focus,
#GeoFlowDynamicForm QComboBox[geoflowInput="true"]:focus,
#GeoFlowDynamicForm QSpinBox[geoflowInput="true"]:focus,
#GeoFlowDynamicForm QDoubleSpinBox[geoflowInput="true"]:focus,
#GeoFlowDynamicForm QDateEdit[geoflowInput="true"]:focus,
#GeoFlowDynamicForm QDateTimeEdit[geoflowInput="true"]:focus {
    border: 1px solid #3b7ddd;
    background: #ffffff;
}

/* ==========================================================
   읽기전용 · 비활성 · 오류 상태
   ========================================================== */
#GeoFlowDynamicForm QLineEdit[readonly="true"],
#GeoFlowDynamicForm QTextEdit[readonly="true"],
#GeoFlowDynamicForm QSpinBox[readonly="true"],
#GeoFlowDynamicForm QDoubleSpinBox[readonly="true"],
#GeoFlowDynamicForm QDateEdit[readonly="true"],
#GeoFlowDynamicForm QDateTimeEdit[readonly="true"],
#GeoFlowDynamicForm QComboBox[readonly="true"],
#GeoFlowDynamicForm QCheckBox[readonly="true"] {
    background: #f1f3f5;
    color: #6c757d;
    border-color: #dee2e6;
}

#GeoFlowDynamicForm QLineEdit[geoflowInput="true"]:disabled,
#GeoFlowDynamicForm QTextEdit[geoflowInput="true"]:disabled,
#GeoFlowDynamicForm QComboBox[geoflowInput="true"]:disabled,
#GeoFlowDynamicForm QSpinBox[geoflowInput="true"]:disabled,
#GeoFlowDynamicForm QDoubleSpinBox[geoflowInput="true"]:disabled,
#GeoFlowDynamicForm QDateEdit[geoflowInput="true"]:disabled,
#GeoFlowDynamicForm QDateTimeEdit[geoflowInput="true"]:disabled {
    background: #e9ecef;
    color: #adb5bd;
    border-color: #dee2e6;
}

#GeoFlowDynamicForm QLineEdit[error="true"],
#GeoFlowDynamicForm QTextEdit[error="true"],
#GeoFlowDynamicForm QComboBox[error="true"],
#GeoFlowDynamicForm QSpinBox[error="true"],
#GeoFlowDynamicForm QDoubleSpinBox[error="true"],
#GeoFlowDynamicForm QDateEdit[error="true"],
#GeoFlowDynamicForm QDateTimeEdit[error="true"] {
    border: 1px solid #dc3545;
}

/* ==========================================================
   참조코드 ComboBox
   ========================================================== */
#GeoFlowDynamicForm QComboBox[geoflowInput="true"] {
    padding-right: 28px;
}

#GeoFlowDynamicForm QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
    background: transparent;
}

#GeoFlowDynamicForm QComboBox::down-arrow {
    image: url(:/geoflow/feather/chevron-down.svg);
    width: 12px;
    height: 12px;
}

#GeoFlowDynamicForm QComboBox QAbstractItemView {
    background: #ffffff;
    color: #495057;
    border: 1px solid #ced4da;
    selection-background-color: #e8f1ff;
    selection-color: #212529;
    outline: 0;
    padding: 3px;
}

/* ==========================================================
   숫자 입력 SpinBox 제어 버튼
   ========================================================== */
#GeoFlowDynamicForm QSpinBox::up-button,
#GeoFlowDynamicForm QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
}

#GeoFlowDynamicForm QSpinBox::down-button,
#GeoFlowDynamicForm QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    background: transparent;
}

#GeoFlowDynamicForm QSpinBox::up-arrow,
#GeoFlowDynamicForm QDoubleSpinBox::up-arrow {
    image: url(:/geoflow/feather/arrow-up.png);
    width: 8px;
    height: 8px;
}

#GeoFlowDynamicForm QSpinBox::down-arrow,
#GeoFlowDynamicForm QDoubleSpinBox::down-arrow {
    image: url(:/geoflow/feather/arrow-down.png);
    width: 8px;
    height: 8px;
}

/* ==========================================================
   Boolean CheckBox
   ========================================================== */
#GeoFlowDynamicForm QCheckBox[geoflowInput="true"] {
    color: #495057;
    spacing: 7px;
    background: transparent;
    font-size: 12px;
}

#GeoFlowDynamicForm QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #adb5bd;
    border-radius: 3px;
    background: #ffffff;
}

#GeoFlowDynamicForm QCheckBox::indicator:hover {
    border-color: #6c757d;
}

#GeoFlowDynamicForm QCheckBox::indicator:checked {
    background: #3b7ddd;
    border-color: #3b7ddd;
    image: url(:/geoflow/feather/check.svg);
}

#GeoFlowDynamicForm QCheckBox::indicator:disabled {
    background: #e9ecef;
    border-color: #dee2e6;
}

#GeoFlowDynamicForm QCheckBox[readonly="true"] {
    color: #6c757d;
    background: transparent;
}

#GeoFlowDynamicForm QCheckBox[readonly="true"]::indicator {
    background: #f1f3f5;
    border-color: #ced4da;
}

#GeoFlowDynamicForm QCheckBox[readonly="true"]::indicator:checked {
    background: #7da4dc;
    border-color: #7da4dc;
    image: url(:/geoflow/feather/check.svg);
}

/* ==========================================================
   날짜 · 일시 선택 위젯
   ========================================================== */
#GeoFlowDynamicForm QDateEdit::drop-down,
#GeoFlowDynamicForm QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 27px;
    border: none;
    background: transparent;
}

#GeoFlowDynamicForm QDateEdit::down-arrow,
#GeoFlowDynamicForm QDateTimeEdit::down-arrow {
    image: url(:/geoflow/feather/calendar.svg);
    width: 13px;
    height: 13px;
}

/* ==========================================================
   Local form-layout editor preview
   ========================================================== */
#GeoFlowDynamicForm[layoutEditorPreview="true"] {
    background: #f8f9fa;
}

#GeoFlowDynamicForm[layoutEditorPreview="true"] QGroupBox[editorRole="group"] {
    margin-top: 10px;
    border: 1px solid #d8dee7;
    border-radius: 6px;
    background: #ffffff;
    font-weight: 600;
}

#GeoFlowDynamicForm[layoutEditorPreview="true"] QGroupBox[editorRole="group"][editorSelected="true"] {
    border: 2px solid #3b7ddd;
}

#GeoFlowDynamicForm[layoutEditorPreview="true"] QFrame#geoFormEditorRow {
    border: 1px dashed #adb5bd;
    border-radius: 5px;
    background: #f8f9fa;
}

#GeoFlowDynamicForm[layoutEditorPreview="true"] QFrame#geoFormEditorRow[editorSelected="true"] {
    border: 2px dashed #3b7ddd;
    background: #eef5ff;
}

#GeoFlowDynamicForm[layoutEditorPreview="true"] QFrame#geoFormEditorRow[dropTarget="true"] {
    border: 2px dashed #1f9d55;
    background: #eaf8f0;
}

#GeoFlowDynamicForm[layoutEditorPreview="true"] QFrame[editorRole="fieldCard"] {
    border: 1px solid #d8dee7;
    border-radius: 5px;
    background: #ffffff;
}

#GeoFlowDynamicForm[layoutEditorPreview="true"] QFrame[editorRole="fieldCard"][editorSelected="true"] {
    border: 2px solid #3b7ddd;
    background: #f4f8ff;
}
