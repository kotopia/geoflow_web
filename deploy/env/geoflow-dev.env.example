# GeoFlow development test-server environment key template.
# DO NOT put real secret values in this file or commit a copied runtime env.

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dev.geoflow.example
DJANGO_CSRF_TRUSTED_ORIGINS=http://dev.geoflow.example
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SECURE=False

# Development central/auth database. This must be non-production for shared test-server use.
CENTRAL_DB_NAME=geoflow_control_dev
CENTRAL_DB_USER=<CENTRAL_DB_USER>
CENTRAL_DB_PASSWORD=<SET_OUTSIDE_GIT>
CENTRAL_DB_HOST=<CENTRAL_DB_HOST>
CENTRAL_DB_PORT=5432

# Development tenant database.
# Current Django static alias is `cheonan_db`; TENANT_DB_NAME selects the physical DB.
# Runtime mapping: cheonan_db(alias) -> geoflow_dev(physical DB).
TENANT_DB_NAME=geoflow_dev
TENANT_DB_USER=<TENANT_DB_USER>
TENANT_DB_PASSWORD=<SET_OUTSIDE_GIT>
TENANT_DB_HOST=<TENANT_DB_HOST>
TENANT_DB_PORT=5432

# Keep static tenant connection available during isolated development unless the
# central secret-reference flow has also been reproduced in a non-production environment.
TENANT_DB_REQUIRE_SECRET_REFERENCES=False

# Never enable production provisioning from the development web runtime.
ENABLE_TENANT_PROVISIONING=0

# Required Django secret. Generate/store only in the host-owned runtime env.
DJANGO_SECRET_KEY=<SET_OUTSIDE_GIT>
